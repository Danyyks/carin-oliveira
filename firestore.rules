rules_version = '2';

// Regras de segurança do Firestore — Carin (link na bio + agendamento).
// Modelo: só a Carin (dona) escreve serviços/horários e gerencia agendamentos;
// o público lê o que é público e só CRIA pedidos de agendamento (nunca edita),
// o que garante o anti-agendamento-duplicado (id determinístico "data_hora").
//
// Endurecido em 28/09/2026 (Fase R, testado no emulador antes de publicar):
// formato exato dos campos, id determinístico validado, `criadoEm` sempre do
// servidor, `slots`/`agendamentos` sempre criados JUNTOS (nunca um sem o outro),
// e `update` restrito à única transição real que o app faz (confirmar).
//
// Pegadinha aprendida testando no emulador: o `id` do `match /slots/{id}` só se
// resolve direito dentro de funções chamadas NUM SÓ NÍVEL a partir do match — numa
// cadeia de 2+ funções (ex.: slotDonoOk → slotCamposOk → idBateComDataHora), o
// motor de regras não captura `id` pelo escopo léxico e a regra quebra com um erro
// de avaliação (não um simples "nega"). Por isso, abaixo, `id` sempre é passado
// como PARÂMETRO explícito — nunca capturado de fora da função.

service cloud.firestore {
  match /databases/{database}/documents {

    // UIDs autorizados como administradores (Console → Authentication → Users).
    function isDono() {
      return request.auth != null && request.auth.uid in [
        'iT3CQL7BYuX7wSpne5cDOXtSrsx2' // conta principal da dona (Carin)
      ];
    }

    function dataValida(v) {
      return v is string && v.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }
    function horaValida(v) {
      return v is string && v.matches('^[0-9]{2}:[0-9]{2}$');
    }
    // O id do documento TEM que ser "data_hora" — trava a duplicidade mesmo fora do app.
    function idBateComDataHora(idDoc, data, hora) {
      return idDoc == data + '_' + hora;
    }
    // `criadoEm` só passa quando foi gravado com serverTimestamp() (nunca uma data
    // arbitrária do cliente): o valor resolvido bate com o horário do próprio request.
    function criadoAgora() {
      return request.resource.data.criadoEm == request.time;
    }

    // Config do estúdio: leitura e escrita só da dona (não usado pelo app hoje;
    // antes a leitura era pública sem necessidade — sem uso real no código).
    match /config/{doc} {
      allow read, write: if isDono();
    }

    // Tokens de push (aparelhos da dona): só a dona lê/escreve.
    // A API na Vercel usa o Admin SDK (ignora estas regras) para disparar o push.
    match /pushTokens/{id} {
      allow read, write: if isDono();
    }

    // Serviços/combos/promoções: leitura pública, escrita só da dona.
    match /servicos/{id} {
      allow read: if true;
      allow write: if isDono();
    }

    // Disponibilidade (dias/horários abertos, bloqueios): leitura pública, escrita só da dona.
    match /disponibilidade/{doc} {
      allow read: if true;
      allow write: if isDono();
    }

    // ---------- Horários ocupados (público: só data/hora/status, sem dados do cliente) ----------
    // status: pendente/confirmado (tem cliente) ou bloqueado (a dona fechou, sem cliente).
    // `origemAgendamento` (opcional, só quem cria é a dona): id do agendamento que causou um
    // bloqueio AUTOMÁTICO (duração de serviço comendo o horário seguinte) — pra liberar sozinho
    // se aquele agendamento for cancelado. Nunca existe num bloqueio manual da folha "Bloquear
    // horários".
    function slotCamposOk(idDoc) {
      let d = request.resource.data;
      return dataValida(d.data) && horaValida(d.hora)
        && idBateComDataHora(idDoc, d.data, d.hora)
        && criadoAgora();
    }
    // Público: só cria pedido "pendente", e só junto com o agendamento correspondente (o
    // mesmo id) — um slot nunca fica "solto" sem o registro do pedido.
    function slotPublicoOk(idDoc) {
      let d = request.resource.data;
      return slotCamposOk(idDoc)
        && d.status == 'pendente'
        && d.keys().hasOnly(['data', 'hora', 'status', 'criadoEm'])
        && existsAfter(/databases/$(database)/documents/agendamentos/$(idDoc));
    }
    // Público, bloqueio AUTOMÁTICO da duração: um serviço mais longo que o intervalo até o(s)
    // próximo(s) horário(s) da tabela fecha esses horários junto com o pedido. Só no MESMO
    // dia, DEPOIS do horário do pedido, e apontando para um pedido que nasce nesta mesma
    // escrita (não existia antes, existe depois) — não dá pra pendurar bloqueio num pedido
    // antigo ou de outra pessoa. Recusar/cancelar o pedido apaga esses bloqueios junto.
    function slotPublicoBloqueioOk(idDoc) {
      let d = request.resource.data;
      let origem = d.get('origemAgendamento', null);
      return slotCamposOk(idDoc)
        && d.status == 'bloqueado'
        && d.keys().hasOnly(['data', 'hora', 'status', 'criadoEm', 'origemAgendamento'])
        && origem is string
        && origem.size() == 16
        && origem.split('_')[0] == d.data
        && origem.split('_')[1] < d.hora
        && !exists(/databases/$(database)/documents/agendamentos/$(origem))
        && existsAfter(/databases/$(database)/documents/agendamentos/$(origem));
    }
    // Dona: cria direto em qualquer status (agendamento manual e bloqueio, automático ou
    // manual). Se vier com `origemAgendamento`, esse agendamento precisa existir ao final
    // da mesma escrita (bloqueio automático sempre é criado junto do agendamento).
    function slotDonoOk(idDoc) {
      let d = request.resource.data;
      // .get(chave, padrão) é o jeito seguro de ler um campo opcional: acessar
      // "d.origemAgendamento" direto dá erro de avaliação quando o campo não existe.
      let origem = d.get('origemAgendamento', null);
      return slotCamposOk(idDoc)
        && d.status in ['pendente', 'confirmado', 'bloqueado']
        && d.keys().hasOnly(['data', 'hora', 'status', 'criadoEm', 'origemAgendamento'])
        && (d.status == 'bloqueado'
            // Bloqueio: sem origem (folha "Bloquear horários") ou com origem, desde que o
            // agendamento apontado exista ao final da mesma escrita (bloqueio automático).
            ? (origem == null
               || (origem is string
                   && existsAfter(/databases/$(database)/documents/agendamentos/$(origem))))
            // Agendamento de verdade (pendente/confirmado): sempre junto do registro com
            // o MESMO id — nunca um slot de cliente "solto" (mesma trava do público).
            : (origem == null && existsAfter(/databases/$(database)/documents/agendamentos/$(idDoc))));
    }
    // Só a transição real que o app faz: pendente → confirmado (confirmarAgendamento),
    // mudando só o `status`. `exists()` nunca lança erro (ao contrário de acessar
    // `resource` direto quando o documento ainda não existe).
    function slotUpdateOk(idDoc) {
      return exists(/databases/$(database)/documents/slots/$(idDoc))
        && resource.data.status == 'pendente'
        && request.resource.data.status == 'confirmado'
        && request.resource.data.keys().hasOnly(resource.data.keys())
        && request.resource.data.data == resource.data.data
        && request.resource.data.hora == resource.data.hora
        && request.resource.data.criadoEm == resource.data.criadoEm;
    }

    match /slots/{id} {
      allow read: if true;
      allow create: if isDono() ? slotDonoOk(id) : (slotPublicoOk(id) || slotPublicoBloqueioOk(id));
      allow update: if isDono() && slotUpdateOk(id);
      allow delete: if isDono();
    }

    // ---------- Agendamentos (com dados do cliente): só a dona lê e gerencia ----------
    function agendamentoCamposOk(idDoc) {
      let d = request.resource.data;
      return dataValida(d.data) && horaValida(d.hora)
        && idBateComDataHora(idDoc, d.data, d.hora)
        && criadoAgora();
    }
    // Público: só cria pedido "pendente", com todos os campos do formulário validados, e só
    // junto com o slot correspondente (nunca um agendamento sem o horário reservado).
    function agendamentoPublicoOk(idDoc) {
      let d = request.resource.data;
      return agendamentoCamposOk(idDoc)
        && d.keys().hasOnly([
          'servicos', 'total', 'clienteNome', 'clienteWhatsapp',
          'data', 'hora', 'diaLabel', 'status', 'criadoEm'
        ])
        && d.status == 'pendente'
        && d.servicos is list && d.servicos.size() >= 1 && d.servicos.size() <= 15
        && d.total is number && d.total >= 0 && d.total <= 100000
        && d.clienteNome is string && d.clienteNome.size() > 1 && d.clienteNome.size() <= 80
        && d.clienteWhatsapp is string && d.clienteWhatsapp.size() >= 8 && d.clienteWhatsapp.size() <= 25
        && d.diaLabel is string && d.diaLabel.size() <= 40
        && !exists(/databases/$(database)/documents/slots/$(idDoc))
        && existsAfter(/databases/$(database)/documents/slots/$(idDoc));
    }
    // Dona: cria direto (agendamento manual), sempre junto com o slot correspondente.
    function agendamentoDonoOk(idDoc) {
      return agendamentoCamposOk(idDoc)
        && existsAfter(/databases/$(database)/documents/slots/$(idDoc));
    }
    // Só a transição real que o app faz: pendente → confirmado (confirmarAgendamento),
    // mudando só o `status`.
    function agendamentoUpdateOk(idDoc) {
      return exists(/databases/$(database)/documents/agendamentos/$(idDoc))
        && resource.data.status == 'pendente'
        && request.resource.data.status == 'confirmado'
        && request.resource.data.keys().hasOnly(resource.data.keys())
        && request.resource.data.servicos == resource.data.servicos
        && request.resource.data.total == resource.data.total
        && request.resource.data.clienteNome == resource.data.clienteNome
        && request.resource.data.clienteWhatsapp == resource.data.clienteWhatsapp
        && request.resource.data.data == resource.data.data
        && request.resource.data.hora == resource.data.hora
        && request.resource.data.diaLabel == resource.data.diaLabel
        && request.resource.data.criadoEm == resource.data.criadoEm;
    }

    match /agendamentos/{id} {
      allow read: if isDono();
      allow create: if isDono() ? agendamentoDonoOk(id) : agendamentoPublicoOk(id);
      allow update: if isDono() && agendamentoUpdateOk(id);
      allow delete: if isDono();
    }
  }
}
