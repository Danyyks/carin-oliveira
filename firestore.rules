rules_version = '2';

// Regras de segurança do Firestore — Carin (link na bio + agendamento).
// Modelo: só a Carin (dona) escreve serviços/horários e gerencia agendamentos;
// o público lê o que é público e só CRIA pedidos de agendamento (nunca edita),
// o que garante o anti-agendamento-duplicado (id determinístico "data_hora").

service cloud.firestore {
  match /databases/{database}/documents {

    // UIDs autorizados como administradores (Console → Authentication → Users).
    function isDono() {
      return request.auth != null && request.auth.uid in [
        'iT3CQL7BYuX7wSpne5cDOXtSrsx2' // conta principal da dona (Carin)
      ];
    }

    // Config do estúdio: leitura pública, escrita só da dona.
    match /config/{doc} {
      allow read: if true;
      allow write: if isDono();
    }

    // Tokens de push (aparelhos da dona): só a dona lê/escreve.
    // A API na Vercel usa o Admin SDK (ignora estas regras) para disparar o push.
    match /pushTokens/{id} {
      allow read, write: if isDono();
    }

    // Serviços/combos/promoções: leitura pública, escrita só da dona.
    match /servicos/{id} {
      allow read: if true;
      allow write: if isDono();
    }

    // Disponibilidade (dias/horários abertos, bloqueios): leitura pública, escrita só da dona.
    match /disponibilidade/{doc=**} {
      allow read: if true;
      allow write: if isDono();
    }

    // Agendamentos:
    // - qualquer um pode CRIAR um pedido (com validação e status "pendente");
    // - NINGUÉM (além da dona) pode editar/apagar -> um 2º create no mesmo id falha,
    //   impedindo dois clientes pegarem o mesmo horário;
    // - só a dona lê a lista e confirma/recusa (update/delete).
    // Horários ocupados (público): só data/hora/status — sem dados do cliente.
    // O público só CRIA (create-only); o id determinístico "data_hora" impede
    // dois pedidos no mesmo horário. Só a dona altera/apaga (confirmar/liberar).
    match /slots/{id} {
      allow read: if true;
      allow create: if request.resource.data.status == 'pendente'
        && request.resource.data.data is string
        && request.resource.data.hora is string
        // o id TEM que ser "data_hora" (trava a duplicidade mesmo fora do app)
        && id == request.resource.data.data + '_' + request.resource.data.hora;
      allow update, delete: if isDono();
    }

    // Agendamentos (com dados do cliente): só a dona lê e gerencia;
    // o público só CRIA o pedido (nunca edita/apaga).
    match /agendamentos/{id} {
      allow read, update, delete: if isDono();
      allow create: if request.resource.data.status == 'pendente'
        // o id TEM que ser "data_hora" (trava a duplicidade mesmo fora do app)
        && id == request.resource.data.data + '_' + request.resource.data.hora
        && request.resource.data.servicos is list
        && request.resource.data.servicos.size() >= 1
        && request.resource.data.servicos.size() <= 15
        && request.resource.data.total is number
        && request.resource.data.clienteNome is string
        && request.resource.data.clienteNome.size() > 1
        && request.resource.data.clienteNome.size() <= 80
        && request.resource.data.clienteWhatsapp is string
        && request.resource.data.clienteWhatsapp.size() >= 8
        && request.resource.data.clienteWhatsapp.size() <= 25
        && request.resource.data.data is string
        && request.resource.data.data.size() == 10
        && request.resource.data.hora is string
        && request.resource.data.hora.size() <= 5
        && request.resource.data.diaLabel is string
        && request.resource.data.diaLabel.size() <= 40;
    }
  }
}
